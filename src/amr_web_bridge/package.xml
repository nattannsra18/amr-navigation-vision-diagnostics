<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_web_bridge</name>
  <version>0.1.0</version>

  <description>
    WebSocket Robot Agent connecting the simulated ROS 2 AMR
    to the Indoor Delivery Robot FastAPI control plane.
  </description>

  <maintainer email="nattann.sra18@gmail.com">
    nattanns18
  </maintainer>

  <license>Apache-2.0</license>

  <depend>rclpy</depend>

  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>