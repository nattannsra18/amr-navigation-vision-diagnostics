<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_marker_0">
    <static>true</static>

    <link name="marker_link">
      <visual name="marker_visual">
        <!-- หมุนป้ายให้หันไปทางหุ่นยนต์ -->
        <pose>0 0 0 0 -1.570796 0</pose>

        <cast_shadows>false</cast_shadows>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.60 0.60</size>
          </plane>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>

          <pbr>
            <metal>
              <albedo_map>
                materials/textures/aruco_0.png
              </albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
