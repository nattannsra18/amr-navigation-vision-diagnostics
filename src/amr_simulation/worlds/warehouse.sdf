<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- พื้น -->
    <model name="warehouse_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>14 12 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>14 12 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- กำแพงด้านเหนือ -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 5.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 0.2 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- กำแพงด้านใต้ -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -5.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 0.2 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- กำแพงด้านตะวันออก -->
    <model name="east_wall">
      <static>true</static>
      <pose>6.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 11 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 11 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- กำแพงด้านตะวันตก -->
    <model name="west_wall">
      <static>true</static>
      <pose>-6.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 11 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 11 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- ชั้นวางสินค้า -->
    <model name="shelf_1">
      <static>true</static>
      <pose>0.5 -2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.8 1.2</size></box></geometry>
          <material>
            <ambient>0.1 0.25 0.7 1</ambient>
            <diffuse>0.1 0.25 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_2">
      <static>true</static>
      <pose>0.5 2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.8 1.2</size></box></geometry>
          <material>
            <ambient>0.1 0.25 0.7 1</ambient>
            <diffuse>0.1 0.25 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_3">
      <static>true</static>
      <pose>4 -2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.8 1.2</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.1 1</ambient>
            <diffuse>0.7 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_4">
      <static>true</static>
      <pose>4 2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.8 1.2</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.1 1</ambient>
            <diffuse>0.7 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- ArUco station marker: dictionary 4X4_50, ID 0 -->
    <include>
      <uri>model://aruco_marker_0</uri>
      <name>aruco_marker_0</name>
      <pose>6.38 -0.50 0.50 0 0 0</pose>
    </include>
  </world>
</sdf>
